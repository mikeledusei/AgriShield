# ============================================================
# AGRISHIELD PROJECT - .gitignore
# ============================================================
# This file spans the entire project structure.
# NEVER commit: data, models, secrets, caches, environments.
# ============================================================


# ============================================================
# 1. ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# ============================================================
# Ignore all .env files with real secrets.
# The .env.example templates MUST remain tracked in Git.
.env
.env.local
.env.production
.env.staging
apps/backend/.env
apps/frontend/.env

# NVIDIA and API keys (in case accidentally saved as separate files)
*.key
*.pem
secrets.json
credentials.json


# ============================================================
# 2. DATA FILES (CRITICAL - Large files, never commit)
# ============================================================
# All raw, processed, and geospatial data from the pipeline.
data_pipeline/data/raw/
data_pipeline/data/processed/
data_pipeline/data/geospatial/

# Common data file extensions anywhere in the project
*.csv
*.tsv
*.parquet
*.feather
*.hdf5
*.h5
*.sqlite
*.db

# Exception: Keep small config/sample files if needed
!data_pipeline/data/.gitkeep
!apps/frontend/assets/kenya_counties.geojson

# Note: The kenya_counties.geojson is a small map asset needed
# by the frontend, so it is explicitly kept tracked.


# ============================================================
# 3. MACHINE LEARNING MODELS (CRITICAL - Large binaries)
# ============================================================
# All saved model binaries from ml-models/models/
ml-models/models/

# Common model file extensions anywhere in the project
*.joblib
*.pkl
*.pickle
*.onnx
*.pt
*.pth
*.h5
*.tflite


# ============================================================
# 4. PYTHON CACHE & COMPILED FILES
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo


# ============================================================
# 5. VIRTUAL ENVIRONMENTS
# ============================================================
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/
virtualenv/


# ============================================================
# 6. PYTHON PACKAGE & BUILD ARTIFACTS
# ============================================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST


# ============================================================
# 7. JUPYTER NOTEBOOKS
# ============================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py


# ============================================================
# 8. TESTING & COVERAGE
# ============================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/


# ============================================================
# 9. TYPE CHECKING & LINTING CACHES
# ============================================================
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/


# ============================================================
# 10. LOGS & TEMPORARY FILES
# ============================================================
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo


# ============================================================
# 11. IDE & EDITOR FILES
# ============================================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.iml


# ============================================================
# 12. OPERATING SYSTEM FILES
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ============================================================
# 13. STREAMLIT & FRONTEND SPECIFIC
# ============================================================
.streamlit/secrets.toml


# ============================================================
# 14. DOCKER (Optional overrides)
# ============================================================
docker-compose.override.yml


# ============================================================
# 15. DOCUMENTATION OUTPUTS (Optional)
# ============================================================
# Keep the report DOCX files tracked since they are deliverables.
# Ignore only generated screenshots if they are too large.
# Uncomment below if you want to exclude screenshots from Git.
# docs/diagrams/screenshots/

venv/
__pycache__/
*.pyc
.env
