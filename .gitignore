# ============================================================
# AGRISHIELD PROJECT - .gitignore
# ============================================================
# This file spans the entire project structure.
# NEVER commit: data, models, secrets, caches, environments.
# ============================================================

.kilo


# ============================================================
# 1. ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# ============================================================
# Ignore all .env files with real secrets.
# The .env.example templates MUST remain tracked in Git.
.env
.env.local
.env.production
.env.staging
apps/backend/.env
apps/frontend/.env
.streamlit/*
!apps/frontend/.streamlit/config.toml

# NVIDIA and API keys (in case accidentally saved as separate files)
*.key
*.pem
secrets.json
secrets.toml
credentials.json


# ============================================================
# 2. DATA FILES (CRITICAL - Large files, never commit)
# ============================================================
# Data stays out of Git. The files the running application needs are listed in the
# explicit allowlist below; adding a new dataset means adding one line here, which
# makes the size and licence of every committed file a deliberate decision.
data_pipeline/data/
*.tsv
*.parquet
*.feather
*.hdf5
*.h5
*.xlsx
*.sqlite
*.db

# --- Tracked inputs (small, required at runtime) ---
!data_pipeline/data/kenya_county_crosswalk.csv
!data_pipeline/data/external/knbs_candidate/maize_outcomes_clean.csv
!data_pipeline/data/external/knbs_candidate/README.md
!data_pipeline/data/external/SOURCES.md
!data_pipeline/data/processed/train_matrix.csv
!data_pipeline/data/processed/test_matrix.csv
!data_pipeline/data/processed/X_test.csv
!data_pipeline/data/processed/y_test.csv
!data_pipeline/data/processed/county_ndvi_stats.csv
!data_pipeline/data/kenya_counties.geojson

# Runtime model artifacts: the champion bundle must ship with the API.
!apps/backend/ml_artifacts/**


# ============================================================
# 3. MACHINE LEARNING MODELS (CRITICAL - Large binaries)
# ============================================================
# All saved model binaries from ml-models/models/
ml-models/models/

# Common model file extensions anywhere in the project
*.pkl
*.pickle
*.onnx
*.pt
*.pth
*.h5
*.tflite

# Research runs are reproducible output, not source: publish them as release assets.
# (ml-models/research_runs/ is therefore not tracked.)


# ============================================================
# 4. PYTHON CACHE & COMPILED FILES
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo


# ============================================================
# 5. VIRTUAL ENVIRONMENTS
# ============================================================
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/
virtualenv/


# ============================================================
# 6. PYTHON PACKAGE & BUILD ARTIFACTS
# ============================================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST


# ============================================================
# 7. JUPYTER NOTEBOOKS
# ============================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py


# ============================================================
# 8. TESTING & COVERAGE
# ============================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/


# ============================================================
# 9. TYPE CHECKING & LINTING CACHES
# ============================================================
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/


# ============================================================
# 10. LOGS & TEMPORARY FILES
# ============================================================
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo


# ============================================================
# 11. IDE & EDITOR FILES
# ============================================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.iml


# ============================================================
# 12. OPERATING SYSTEM FILES
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ============================================================
# 13. STREAMLIT & FRONTEND SPECIFIC
# ============================================================
.streamlit/secrets.toml


# ============================================================
# 14. DOCKER (Optional overrides)
# ============================================================
docker-compose.override.yml


# ============================================================
# 15. DOCUMENTATION OUTPUTS (Optional)
# ============================================================
# Keep the report DOCX files tracked since they are deliverables.
# Ignore only generated screenshots if they are too large.
# Uncomment below if you want to exclude screenshots from Git.
# docs/diagrams/screenshots/

venv/
__pycache__/
*.pyc
.env

# Reproducible research runs; promote artifacts only after review.
ml-models/experiments/
ml-models/research_runs/
data_pipeline/outputs/

# Large binary deliverables stay out of Git (the 12.5 MB slide deck is kept on disk
# and distributed separately). Small .md/.csv/.json deliverables stay tracked above.
docs/presentation/*.pptx
*.pptx
*.xlsx

# Research model binaries are release assets, not tracked files. The champion artifact
# and its scaler are the exception: the API loads them at runtime and the image copies
# them, so a clean clone must contain them.
*.joblib
!apps/backend/ml_artifacts/*.joblib

# Local databases and generated reports
apps/backend/*.db
apps/backend/*.sqlite
test.db
ci_migrations.db
