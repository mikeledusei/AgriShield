{
  "name": "AgriShield (Python 3.11)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "apps/backend/main.py", "apps/frontend/streamlit_app.py"]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "[python]": {
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": { "source.fixAll.ruff": "explicit" }
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": "pip install --user -r apps/backend/requirements-dev.txt -r apps/frontend/requirements.txt -c constraints.txt",
  "postStartCommand": "bash .devcontainer/start.sh",
  "portsAttributes": {
    "8501": { "label": "Dashboard", "onAutoForward": "openPreview" },
    "8000": { "label": "API", "onAutoForward": "silent" }
  },
  "forwardPorts": [8501, 8000]
}
