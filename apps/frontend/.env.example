# =============================================================================
#  AgriShield Frontend — Environment Variables (Streamlit)
# =============================================================================
#  HOW TO USE:
#    1. Copy this file:  cp .env.example .env
#    2. Fill the values below (only AGRISHIELD_API_URL is required)
#    3. Real env vars always win over .env — Docker/Render/Vercel set them too
#    4. Never commit your real .env
#
#  LOCAL DEV (nothing to change):
#    AGRISHIELD_API_URL=http://127.0.0.1:8000/api/v1  → talks to your local backend
#
#  PRODUCTION (Vercel / Docker / Streamlit Cloud):
#    Set AGRISHIELD_API_URL to your deployed API:
#      https://agrishield-api.onrender.com/api/v1
#    Set AGRISHIELD_ENV=production so a missing URL fails fast (no silent localhost)
# =============================================================================

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  1) BACKEND CONNECTION  ★ REQUIRED
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  The URL the *Streamlit server* uses to reach FastAPI (not the browser).
#  Include or omit /api/v1 — the client appends it if missing.
#  In Docker, this must be reachable from the dashboard container (not localhost).
AGRISHIELD_API_URL=http://127.0.0.1:8000/api/v1
#  Production example:
#    AGRISHIELD_API_URL=https://agrishield-api.onrender.com/api/v1

#  Deprecated alias — still read for backward compat, prefer the line above:
#    BACKEND_URL=

#  Only needed if your backend ever enables auth (currently PUBLIC_MODE=True → not needed):
AGRISHIELD_API_TOKEN=

#  How long to wait for the backend before showing “could not be reached”:
AGRISHIELD_API_TIMEOUT=30               # seconds

#  Fail-fast in prod if AGRISHIELD_API_URL is unset (dev allows localhost fallback):
AGRISHIELD_ENV=development              # development | production

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  2) STREAMLIT SERVER — Allowed hosts / origins (Docker & proxy deployments)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  These are *not* read by Python — the frontend Dockerfile forwards them as:
#    --server.allowedHosts / --server.corsAllowedOrigins
#  So set them in your container / platform env (Render, Docker, etc.), not just .env
#
#  Comma-separated allowlists. Example for a Vercel + Render stack:
#    AGRISHIELD_ALLOWED_HOSTS=agrishield.vercel.app
#    AGRISHIELD_ALLOWED_ORIGINS=https://agrishield.vercel.app
AGRISHIELD_ALLOWED_HOSTS=
AGRISHIELD_ALLOWED_ORIGINS=
