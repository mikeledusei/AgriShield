# URL the Streamlit server uses to reach the backend (not the browser's URL).
# Include or omit /api/v1; it is appended when missing.
AGRISHIELD_API_URL=http://127.0.0.1:8000/api/v1

# Required only when the backend runs with PUBLIC_MODE=False.
AGRISHIELD_API_TOKEN=

# Seconds to wait for the backend before showing an error.
AGRISHIELD_API_TIMEOUT=30

# Set to production to make an unset AGRISHIELD_API_URL a startup error.
AGRISHIELD_ENV=development

# Comma-separated allowlists for the Streamlit server behind a proxy.
# Passed through by the frontend Dockerfile as --server.allowedHosts / --server.corsAllowedOrigins.
AGRISHIELD_ALLOWED_HOSTS=
AGRISHIELD_ALLOWED_ORIGINS=
