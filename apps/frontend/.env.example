# AgriShield Dashboard (Streamlit) Environment Variables
#
# Copy to apps/frontend/.env. The dashboard reads this file automatically; a real
# environment variable of the same name takes precedence over it.
#
# Every variable below is read by the dashboard. No others are used.

# --- Backend location ---
# The URL the STREAMLIT SERVER uses to reach the API, not the browser's URL.
# Include or omit /api/v1 — it is appended when missing.
# In Docker this must be a hostname reachable from the dashboard container, not localhost.
AGRISHIELD_API_URL=http://127.0.0.1:8000/api/v1

# Deprecated alias for AGRISHIELD_API_URL; both are read if set.
# BACKEND_URL=

# Required only when the backend runs with PUBLIC_MODE=False (sent as a bearer token).
AGRISHIELD_API_TOKEN=

# Seconds to wait for the backend before showing an error.
AGRISHIELD_API_TIMEOUT=30

# development | production. In production an unset AGRISHIELD_API_URL is a startup error
# instead of falling back to localhost.
AGRISHIELD_ENV=development

# --- Streamlit server (proxy/Docker deployments) ---
# Comma-separated allowlists. The frontend Dockerfile passes these through as
# --server.allowedHosts / --server.corsAllowedOrigins; they are NOT read by the app code,
# so set them in the environment the container starts with, not only in .env.
# Example: agrishield.example.com or agrishield.example.com,10.0.0.5
AGRISHIELD_ALLOWED_HOSTS=
AGRISHIELD_ALLOWED_ORIGINS=
