# ============================================================
# AGRISHIELD FRONTEND - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to GitHub.
# Command:  cp .env.example .env
# ============================================================

# ---------- BACKEND CONNECTION ----------
# URL of the FastAPI backend.
# Local development:  http://127.0.0.1:8000
# Production:         https://your-backend-url.onrender.com
BACKEND_API_URL=http://127.0.0.1:8000

# ---------- API SECURITY ----------
# Must match the API_KEY set in the backend .env file.
API_KEY=your-secure-api-key-here

# ---------- UI SETTINGS ----------
# Default language for the dashboard. Options: en, sw
DEFAULT_LANGUAGE=en

# ---------- MAP SETTINGS ----------
# Path to the Kenya counties GeoJSON file (relative to frontend folder).
GEOJSON_PATH=assets/kenya_counties.geojson