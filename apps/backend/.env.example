# AgriShield Backend Environment Variables
#
# Copy to apps/backend/.env and fill in real values. Never commit .env.
# Production fails closed: `APP_ENV=production` refuses to start unless identity,
# database, secrets and CORS are all configured. See docs/DEPLOYMENT.md.

# --- Application ---
APP_NAME=AgriShield API
# development | staging | production
APP_ENV=development
DEBUG=False
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
# INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO

# Anonymous access. Convenient locally; production requires False + Supabase.
PUBLIC_MODE=True

# --- Database ---
# Leave empty to use the local SQLite file (apps/backend/agrishield.db).
# Production must set a durable URL; the container filesystem is ephemeral.
# Schema is applied with: alembic upgrade head   (or: python init_db.py)
DATABASE_URL=
DB_ECHO=False
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_POOL_RECYCLE=280

# --- Identity (required when PUBLIC_MODE=False) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=agrishield-uploads

# --- Secrets (required in production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
API_KEY=

# --- CORS ---
# Comma-separated browser origins that may call this API.
# The default (empty) allows only localhost:8501 for the local dashboard.
# Never use '*' with credentials.
CORS_ORIGINS=

# --- Uploads ---
MAX_UPLOAD_BYTES=10485760

# --- Gria AI agent (optional) ---
# Without a working key Gria returns a labelled deterministic summary, not AI text.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Model artifact ---
# MODEL_PATH points at the champion artifact inside the image.
# MODEL_PATH=/app/apps/backend/ml_artifacts/lightgbm_agrishield_v1.joblib
# Refuse to load an artifact whose SHA-256 differs from the recorded hash.
REQUIRE_MODEL_HASH=True

# --- Cache ---
# Reserved for a future shared cache; the API currently caches in-process.
REDIS_URL=
CACHE_TTL=300
