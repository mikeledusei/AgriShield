# AgriShield Backend Environment Variables
#
# Copy to apps/backend/.env and fill in real values. Never commit .env.
# Every variable the application reads is listed below; the defaults shown are the
# values used when the file is absent, so a fresh clone runs with no configuration.
#
# Production fails closed: APP_ENV=production refuses to start unless PUBLIC_MODE=False
# with Supabase configured, DATABASE_URL set, SECRET_KEY and API_KEY non-placeholder,
# and CORS_ORIGINS a real origin list. See docs/DEPLOYMENT.md.

# --- Application ---
APP_NAME=AgriShield API
# development | staging | production
APP_ENV=development
# Enables /docs and verbose errors; keep False in production.
DEBUG=False
# In-process only; the Dockerfile/uvicorn command decides the real bind address.
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Access control ---
# True = every endpoint is anonymous. Convenient locally, and NOT a security boundary:
# anyone who can reach the port can create reports and read stored data.
# Production requires PUBLIC_MODE=False plus the Supabase trio below.
PUBLIC_MODE=True

# Used by the API-key path when Supabase is not configured.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=dev-api-key-change-in-production
# Signs session/derived values. Must be non-placeholder in production.
SECRET_KEY=dev-secret-key-change-in-production

# --- Database ---
# Empty = local SQLite at apps/backend/agrishield.db. Not durable: do not use in production.
# PostgreSQL example: postgresql+psycopg2://user:pass@host:5432/agrishield
DATABASE_URL=
DB_ECHO=False
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_POOL_RECYCLE=280

# --- Identity (required when PUBLIC_MODE=False) ---
# supabase_configured needs URL + SERVICE_ROLE_KEY; the placeholder URL below is rejected.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=agrishield-uploads

# --- CORS ---
# Comma-separated browser origins allowed to call this API.
# Empty = localhost Streamlit default (http://localhost:8501 and http://127.0.0.1:8501).
# Never '*' with credentials. Production must list the dashboard origin, e.g. https://agrishield.example.com
CORS_ORIGINS=

# --- Uploads ---
# 10 MB. Keep in step with MAX_UPLOAD_BYTES in the reverse proxy, or uploads fail there first.
MAX_UPLOAD_BYTES=10485760

# --- Gria AI agent (optional) ---
# Without a working key Gria returns a labelled deterministic summary, not generated text.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Seconds before a high-reasoning provider call is abandoned in favour of the deterministic fallback.
LLM_TIMEOUT_SECONDS=60
# Requests per minute per caller on /gria/chat and /gria/analyze. 0 = no limit (local default).
AI_RATE_LIMIT_PER_MINUTE=0

# --- Model artifact ---
# Defaults to ml_artifacts/lightgbm_agrishield_v1.joblib next to the backend package.
# Set it when the artifact lives elsewhere, e.g. MODEL_PATH=/app/apps/backend/ml_artifacts/lightgbm_agrishield_v1.joblib
# MODEL_PATH=
# Refuse to start if the artifact's SHA-256 differs from the recorded hash.
REQUIRE_MODEL_HASH=True

# --- Cache ---
# The API caches in-process today. A Redis URL is read but no shared cache is used yet.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300
