# =============================================================================
#  AgriShield Backend — Environment Variables
#  Neon PostgreSQL + XGBoost Champion
# =============================================================================
#  HOW TO USE:
#    1. Copy this file:  cp .env.example .env
#    2. Fill every REQUIRED value (marked with ★)
#    3. Never commit your real .env — only this example is tracked
#
#  QUICK START (local dev):
#    Leave DATABASE_URL empty → local SQLite at apps/backend/agrishield.db
#    PUBLIC_MODE=True + CORS empty = localhost:8501 allowed, no auth needed
#
#  PRODUCTION (Render / VPS):
#    Set DATABASE_URL = Neon pooled URL, SECRET_KEY + API_KEY, CORS_ORIGINS
#    APP_ENV=production will refuse to start if any are placeholders
#    See docs/DEPLOYMENT.md  &  render.yaml for the full checklist
# =============================================================================

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  1) CORE — Application
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
APP_NAME=AgriShield API
APP_ENV=development                    # development | staging | production
DEBUG=False                            # verbose errors + /docs in dev only
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  2) DATABASE — Neon PostgreSQL  ★ REQUIRED in production
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Neon is the ONLY database. No Supabase.
#
#  Where to copy the URL (30 sec):
#    → https://console.neon.tech
#    → Project: agrishield → Dashboard → Connect
#    → Role: neondb_owner | Database: neondb | ☑ Pooled connection → Copy
#
#  What it looks like (replace <PASSWORD> + <EP-HOST>):
#    postgresql://neondb_owner:<PASSWORD>@<EP-HOST>-pooler.<REGION>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
#  Example (placeholder — replace with your real one):
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxxxxxxxxxxxxxxxxxxxx@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#  Breakdown:
#    PGHOST     = ep-example-123456-pooler.us-east-1.aws.neon.tech  # pooled host, NEVER localhost
#    PGUSER     = neondb_owner
#    PGPASSWORD = npg_xxxxxxxxxxxxxxxxxxxxxxxx                      # Neon → Show password
#    PGDATABASE = neondb
#    PGSSLMODE  = require
#
#  Local dev fallback (no Neon) — comment the line above and use:
#    DATABASE_URL=

#  Pool tuning — safe defaults for Neon free tier; change only if you hit limits
DB_ECHO=False                          # SQL echo to logs
DB_CONNECT_TIMEOUT=10                  # seconds to wait for a cold Neon compute
DB_POOL_SIZE=5                         # connections kept open (Neon free: keep low)
DB_POOL_RECYCLE=280                    # recycle before Neon's 5-min idle close

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  3) SECURITY — Secrets & CORS  ★ REQUIRED in production
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Public prototype: no login provider. PUBLIC_MODE stays True (kept for compat).
PUBLIC_MODE=True

#  Generate fresh secrets for production — never keep the dev-* placeholder:
#    python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-key-change-in-production      # ★ real secret in prod
API_KEY=dev-api-key-change-in-production            # ★ real secret in prod

#  CORS — browser origins allowed to call this API
#  Dev: empty = http://localhost:8501 + http://127.0.0.1:8501 allowed
#  Prod: list your dashboard, e.g. https://agrishield.vercel.app,https://agrishield.example.com
#  Never "*" with credentials.
CORS_ORIGINS=

#  Uploads
MAX_UPLOAD_BYTES=10485760               # 10 MB

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  4) FEATURES — AI, Model, Cache
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Gria AI (optional) — without a key, Gria returns a labelled deterministic summary
NVIDIA_API_KEY=                        # NVIDIA NIM key  (optional) — get one at https://build.nvidia.com
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# meta/llama-3.3-70b EOL 2026-08-26 — use 405b/Maverick/Scout/Nemotron (all support agentic tool calling)
NVIDIA_MODEL=meta/llama-3.1-405b-instruct
LLM_TIMEOUT_SECONDS=60                 # abandon slow AI call → fallback summary
AI_RATE_LIMIT_PER_MINUTE=0             # 0 = no limit (dev default)

#  Champion model — XGBoost (val F1 0.8689 on 2022-2023). Hash-verified on load.
#  Default is apps/backend/ml_artifacts/champion_model.joblib; override only if moved:
#    MODEL_PATH=/app/apps/backend/ml_artifacts/champion_model.joblib
REQUIRE_MODEL_HASH=True                # must stay True in prod (joblib can exec code)

#  Cache (in-process today; REDIS_URL reserved for future shared cache)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300                          # seconds
