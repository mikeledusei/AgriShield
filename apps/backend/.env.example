# AgriShield Backend Environment Variables — Neon PostgreSQL only
#
# Copy to apps/backend/.env and fill in real values. Never commit .env.
# Production fails closed: APP_ENV=production refuses to start unless DATABASE_URL
# (Neon pooled URL), SECRET_KEY and API_KEY are non-placeholder and CORS_ORIGINS
# is a real origin list. See docs/DEPLOYMENT.md.

# --- Application ---
APP_NAME=AgriShield API
# development | staging | production
APP_ENV=development
DEBUG=False
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Access control ---
# Public prototype — no auth provider. PUBLIC_MODE is kept for compat and stays True.
PUBLIC_MODE=True
API_KEY=dev-api-key-change-in-production
SECRET_KEY=dev-secret-key-change-in-production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database — Neon PostgreSQL (ONLY database, no Supabase) ---
# Where to get it (30s):
#   https://console.neon.tech → your project (agrishield) → Dashboard → Connect
#   → Role: neondb_owner, Database: neondb, Pooled connection ✓ → Copy string
# It ALWAYS looks like this — just replace the password/host:
#   postgresql://neondb_owner:<PASSWORD>@<EP-HOST>-pooler.<REGION>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# PRODUCTION: paste your real pooled URL (keep ?sslmode=require). Example placeholder:
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxxxxxxxxxxxxxxxxxxxx@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Example breakdown (same URL split):
#   PGHOST=ep-example-123456-pooler.us-east-1.aws.neon.tech  (Neon pooled host, NEVER localhost)
#   PGUSER=neondb_owner
#   PGPASSWORD=npg_xxxxxxxxxxxxxxxxxxxxxxxx                    (from Neon → Show password)
#   PGDATABASE=neondb
#   PGSSLMODE=require
#
# LOCAL DEV ONLY (no Neon): comment out DATABASE_URL above and use empty → SQLite fallback:
# DATABASE_URL=
DB_ECHO=False
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_POOL_RECYCLE=280

# --- CORS ---
# Comma-separated browser origins allowed to call this API.
# Empty = localhost Streamlit default (http://localhost:8501 and http://127.0.0.1:8501).
# Never '*' with credentials. Production must list the dashboard origin.
CORS_ORIGINS=

# --- Uploads ---
MAX_UPLOAD_BYTES=10485760

# --- Gria AI agent (optional) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
LLM_TIMEOUT_SECONDS=60
AI_RATE_LIMIT_PER_MINUTE=0

# --- Model artifact — XGBoost champion ---
# Champion selected on 2022-2023 validation F1 (0.8689). File is champion_model.joblib (hash verified).
# MODEL_PATH override example: /app/apps/backend/ml_artifacts/champion_model.joblib
REQUIRE_MODEL_HASH=True

# --- Cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300
